<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.finagent</groupId>
  <artifactId>financial-agent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>financial-agent</name>
  <description>金融研报智能分析 Agent</description>

  <properties>
    <java.version>21</java.version>
    <!-- 测试分三层，规则见 docs/测试规范.md：
         1. 纯单测（不启 Spring 容器）—— -Pfast 只跑这一层，约 45 秒，改代码时用；
         2. 集成测试（@Tag("db")，真库真上下文）—— 默认 mvn test 会跑，-Pdb 只跑这一层；
         3. 端到端（@Tag("e2e")，真模型/真 Kafka/真 COS）—— 默认排除，按需点名跑。
         跑 e2e 时要先把排除清空再选中标签（-Dgroups 是包含语义，
         不把 excludedGroups 清掉的话会一条都不跑）：
           mvn -Dsurefire.excludedGroups= -Dgroups=e2e -Dtest=AnswerEvalTest test -->
    <surefire.excludedGroups>e2e</surefire.excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>2.0.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- 数据库版本化迁移。三个 artifact 缺一不可：
         1) spring-boot-flyway         Spring Boot 4 把自动配置拆成了独立模块
                                       （类比 spring-boot-jdbc），只加 flyway-core 不会生效；
         2) flyway-core                迁移引擎本体；
         3) flyway-database-postgresql Flyway 10+ 拆出的数据库方言模块，
                                       缺了报 "No database found to handle jdbc:postgresql:..."。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Spring AI：聊天 + 向量模型（走百炼 OpenAI 兼容接口） -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>
    <!-- Spring AI：PgVector 向量库 -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
    </dependency>

    <!-- Kafka（阶段 7：异步与任务化）。Boot 4 把自动配置拆成模块，同 spring-boot-flyway 写法；
         spring-kafka 4.0.7（含 kafka-clients 4.1.2）由该模块传递引入，版本走 spring-boot BOM。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
    </dependency>

    <!-- PDF 单页渲染（阶段 12：点引用看原文页图）。3.0.5 是 3.0.x 线当前版本；
         Spring Boot BOM 不托管 pdfbox，必须显式写版本。 -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.5</version>
    </dependency>

    <!-- 腾讯云 COS 对象存储（设计文档 §14：经 ObjectStorage 抽象访问，便于替换） -->
    <dependency>
      <groupId>com.qcloud</groupId>
      <artifactId>cos_api</artifactId>
      <version>5.6.281</version>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 内循环：只跑不启容器的单测，约 45 秒 -->
    <profile>
      <id>fast</id>
      <properties>
        <surefire.excludedGroups>e2e,db</surefire.excludedGroups>
      </properties>
    </profile>
    <!-- 只跑 @Tag("db") 的集成测试 -->
    <profile>
      <id>db</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>db</groups>
              <excludedGroups>e2e</excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
